rules_version = '2';

// MesDispos — règles de sécurité Firestore (AGENTS.md §11).
//
// Deux natures de session coexistent :
//  - session « nom seul » : `request.auth == null`, `uid` = `anon_<sha256[:12]>` ;
//  - session Firebase (administrateur) : `request.auth != null`, `uid` =
//    `request.auth.uid` (connexion **anonyme**, aucun compte tiers).
//
// L'admin n'est identifié que par l'existence du document `admins/{uid}`, écrit
// **manuellement depuis la console Firebase** (jamais depuis l'application).
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() {
      return request.auth != null;
    }

    // Session « nom seul » : `uid` d'anonyme bien formé (sha256 du nom).
    // La forme du `uid` suffit à valider la partition : la session Firebase
    // éventuelle (administrateur) ne doit pas empêcher un professeur de
    // déclarer ses disponibilités dans sa propre partition.
    // NB : une fonction de rules **ne capture pas** les variables du chemin
    // (`{uid}`) : le `uid` doit être passé en paramètre, sinon le compilateur
    // signale « Invalid variable name: uid » et la branche anonyme est refusée.
    function uidAnonymeValide(uid) {
      return uid.matches('^anon_[0-9a-f]{12}$');
    }

    function admin() {
      return connecte() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Créneaux proposés : lecture ouverte (toute session comprise), écriture
    // admin seule.
    match /creneaux/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Inventaire des professeurs : la planification (AutoPlanning) a besoin de
    // **lister** l'ensemble des partitions `users/*` pour récupéter tous les
    // professeurs et leurs disponibilités. La lecture de la collection `users`
    // est donc ouverte ; les documents restent modifiables par leur seul
    // titulaire (règle ci-dessous). La collection ne contient que l'identité
    // minimale (`login`, `nom`, `prenom`).
    match /users {
      allow read: if true;
    }

    // Profil du professeur (`users/{uid}`) : `login`, `nom`, `prénom`.
    // Lecture ouverte : l'inventaire des professeurs est nécessaire à la
    // planification (AutoPlanning) et le profil ne contient que l'identité
    // minimale. L'écriture est réservée à son titulaire **et** à
    // l'administrateur (attribution automatique de créneaux).
    match /users/{uid} {
      allow read: if true;
      allow write: if (connecte() && request.auth.uid == uid) || uidAnonymeValide(uid) || admin();
    }

    // Disponibilités : chaque partition n'est accessible qu'à son titulaire.
    //  - partition Firebase (administrateur) : `request.auth.uid == uid` ;
    //  - partition « nom seul » : `uid` de la forme `anon_<sha256[:12]>`.
    // L'administrateur peut écrire dans **toute** partition : c'est ce qui
    // permet l'attribution automatique de créneaux à des professeurs.
    match /users/{uid}/dispos/{creneauId} {
      allow read, write: if (connecte() && request.auth.uid == uid) || uidAnonymeValide(uid) || admin();
    }

    // Suppression groupée par l'administrateur : `collectionGroup('dispos')`
    // traverse **toutes** les partitions `users/*/dispos` en une requête. Seul
    // un administrateur peut les lister (`read`) et les supprimer (`delete`) ;
    // l'écriture unitaire des professeurs reste régie par la règle de
    // partition ci-dessus (Firestore accorde l'accès dès qu'une règle l'autorise).
    match /{chemin=**}/dispos/{creneauId} {
      allow read, delete: if admin();
    }

    // Liste des administrateurs : lecture par le concerné, écriture interdite
    // à l'application (console Firebase / Admin SDK uniquement).
    match /admins/{uid} {
      allow read: if connecte() && request.auth.uid == uid;
      allow write: if false; // géré via la console Firebase / Admin SDK
    }

    // Tout le reste est interdit par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
